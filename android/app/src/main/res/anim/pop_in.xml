<?xml version="1.0" encoding="utf-8"?>
<!-- iOS-like navigation: the new screen slides in from the right over the old, which drifts left and dims -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="420"
    android:interpolator="@android:interpolator/fast_out_slow_in"
    android:zAdjustment="normal">
    <translate android:fromXDelta="-28%" android:toXDelta="0" />
    <alpha android:fromAlpha="0.6" android:toAlpha="1.0" />
</set>
